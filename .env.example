# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:AAH_your_telegram_bot_token_here

# Real email for OpenAlex & Unpaywall Polite Pool (high rate-limit, 100% free)
CONTACT_EMAIL=your_email@gmail.com

# Local proxy for Windows testing in Iran (leave empty on VPS or Hugging Face Spaces)
# Example for v2rayN: socks5://127.0.0.1:10808 or http://127.0.0.1:10809
TELEGRAM_PROXY=

# Fallback mirrors for paywalled DOIs
FALLBACK_MIRRORS=https://sci-hub.se,https://sci-hub.st,https://sci-hub.ru

# Healthcheck server port (keep 7860 for Hugging Face Spaces)
PORT=7860
